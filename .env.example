# Copy to .env and fill in. .env is gitignored. Never commit or share real values.

# Canvas
CANVAS_BASE_URL=https://canvas.mit.edu
CANVAS_TOKEN=paste-your-canvas-token-here
CANVAS_COURSE_ID=40577
CANVAS_TOPIC_ID=448963

# Claude API
ANTHROPIC_API_KEY=paste-your-anthropic-key-here
AGENT_MODEL=claude-opus-5-5

# Agent behaviour (defaults shown)
AGENT_NAME=Threadweaver
AGENT_STATE_DIR=state
AGENT_LOG_DIR=logs
AGENT_MAX_POSTS_PER_HOUR=3
AGENT_MAX_POSTS_PER_CYCLE=1
AGENT_MAX_CONSECUTIVE_FAILURES=3
